#!/bin/bash

# Mock dbus-send for CI testing

# 1. ListNames (Check for players)
if [[ "$*" == *"org.freedesktop.DBus.ListNames"* ]]; then
    echo "   string \"org.mpris.MediaPlayer2.spotify\""
    echo "   string \"org.mpris.MediaPlayer2.vlc\""
    echo "   string \"org.mpris.MediaPlayer2.chromium.instance1234\""
    echo "   string \"org.mpris.MediaPlayer2.firefox.instance_1_99\""
    exit 0
fi

# 2. Get Metadata (Title/Artist)
if [[ "$*" == *"org.freedesktop.DBus.Properties.Get"* && "$*" == *"Metadata"* ]]; then
    if [[ "$*" == *"chromium"* ]]; then
        echo "   variant       array ["
        echo "         dict entry("
        echo "            string \"xesam:title\""
        echo "            variant                string \"PWA Song\""
        echo "         )"
        echo "         dict entry("
        echo "            string \"xesam:artist\""
        echo "            variant                string \"PWA Artist\""
        echo "         )"
        echo "         dict entry("
        echo "            string \"mpris:artUrl\""
        echo "            variant                string \"https://i.scdn.co/image/ab67616d0000b273b1897d28c89b2f293cfd9431\""
        echo "         )"
        echo "      ]"
        exit 0
    fi

    if [[ "$*" == *"vlc"* ]]; then
        echo "   variant       array ["
        echo "         dict entry("
        echo "            string \"xesam:title\""
        echo "            variant                string \"Audio Track 01.flac\""
        echo "         )"
        echo "         dict entry("
        echo "            string \"xesam:artist\""
        echo "            variant                array ["
        echo "               string \"VLC Artist\""
        echo "            ]"
        echo "         )"
        echo "      ]"
        exit 0
    fi

    if [[ "$*" == *"firefox"* ]]; then
        echo "   variant       array ["
        echo "         dict entry("
        echo "            string \"xesam:title\""
        echo "            variant                string \"Go Programming Tutorial\""
        echo "         )"
        echo "         dict entry("
        echo "            string \"xesam:url\""
        echo "            variant                string \"https://www.youtube.com/watch?v=tutorial123\""
        echo "         )"
        echo "      ]"
        exit 0
    fi

    echo "   variant       array ["
    echo "         dict entry("
    echo "            string \"xesam:title\""
    echo "            variant                string \"CI Test Song\""
    echo "         )"
    echo "         dict entry("
    echo "            string \"xesam:artist\""
    echo "            variant                string \"CI Artist\""
    echo "         )"
    echo "      ]"
    exit 0
fi

# 3. Get PlaybackStatus
if [[ "$*" == *"org.freedesktop.DBus.Properties.Get"* && "$*" == *"PlaybackStatus"* ]]; then
    # Return "Playing" by default
    echo "   variant       string \"Playing\""
    exit 0
fi

# 4. Pause/Play Commands
if [[ "$*" == *"org.mpris.MediaPlayer2.Player.Pause"* ]]; then
    if [[ "$*" == *"chromium"* ]]; then
        echo "[DBUS] Pause signal sent to Chromium PWA" >> /tmp/salat-break-dbus.log
    elif [[ "$*" == *"vlc"* ]]; then
        echo "[DBUS] Pause signal sent to VLC" >> /tmp/salat-break-dbus.log
    elif [[ "$*" == *"firefox"* ]]; then
        echo "[DBUS] Pause signal sent to Firefox" >> /tmp/salat-break-dbus.log
    else
        echo "[DBUS] Pause signal sent to Spotify" >> /tmp/salat-break-dbus.log
    fi
    exit 0
fi

if [[ "$*" == *"org.mpris.MediaPlayer2.Player.Play"* ]]; then
    if [[ "$*" == *"chromium"* ]]; then
        echo "[DBUS] Play signal sent to Chromium PWA" >> /tmp/salat-break-dbus.log
    elif [[ "$*" == *"vlc"* ]]; then
        echo "[DBUS] Play signal sent to VLC" >> /tmp/salat-break-dbus.log
    elif [[ "$*" == *"firefox"* ]]; then
        echo "[DBUS] Play signal sent to Firefox" >> /tmp/salat-break-dbus.log
    else
        echo "[DBUS] Play signal sent to Spotify" >> /tmp/salat-break-dbus.log
    fi
    exit 0
fi

exit 0
